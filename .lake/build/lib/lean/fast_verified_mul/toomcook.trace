   "fast_verified_mul/toomcook.lean:658:0: toomcook.induct (BASE KA KB : ℕ) (h_base : 1 < BASE) (h_k : 1 < KA ∧ 1 < KB) (POINTS : Vector ℤ (KA + KB - 1))\n  (h_inj : Function.Injective POINTS.get) (motive : ℤ → ℤ → Prop)\n  (case1 : ∀ (a b : ℤ), ↑(toomcook_P BASE a b) ≤ toomcook_THETA BASE KA KB POINTS → motive a b)\n  (case2 :\n    ∀ (a b : ℤ),\n      ¬↑(toomcook_P BASE a b) ≤ toomcook_THETA BASE KA KB POINTS →\n        have a_abs := a.natAbs;\n        have b_abs := b.natAbs;\n        have pcoeffs := toomcook_split KA KB KA BASE a_abs b_abs a_abs;\n        have qcoeffs := toomcook_split KA KB KB BASE a_abs b_abs b_abs;\n        have p_vec := fun i ↦ eval_vec_as_poly pcoeffs (POINTS.get i);\n        have q_vec := fun i ↦ eval_vec_as_poly qcoeffs (POINTS.get i);\n        Xor' (a < 0) (b < 0) →\n          (∀ (i : Fin (KA + KB - 1)),\n              have aa := p_vec i;\n              have bb := q_vec i;\n              motive ↑aa.natAbs ↑bb.natAbs) →\n            motive a b)\n  (case3 :\n    ∀ (a b : ℤ),\n      ¬↑(toomcook_P BASE a b) ≤ toomcook_THETA BASE KA KB POINTS →\n        have a_abs := a.natAbs;\n        have b_abs := b.natAbs;\n        have pcoeffs := toomcook_split KA KB KA BASE a_abs b_abs a_abs;\n        have qcoeffs := toomcook_split KA KB KB BASE a_abs b_abs b_abs;\n        have p_vec := fun i ↦ eval_vec_as_poly pcoeffs (POINTS.get i);\n        have q_vec := fun i ↦ eval_vec_as_poly qcoeffs (POINTS.get i);\n        ¬Xor' (a < 0) (b < 0) →\n          (∀ (i : Fin (KA + KB - 1)),\n              have aa := p_vec i;\n              have bb := q_vec i;\n              motive ↑aa.natAbs ↑bb.natAbs) →\n            motive a b)\n  (a b : ℤ) : motive a b",
